# Public URL of the deployment, used for metadata, robots.txt and sitemap.xml
SITE_URL=http://localhost:3000

# Lead storage. Leave unset locally to use a SQLite file (leads.db).
# On Vercel set a Turso/libSQL database, since the filesystem there is read-only.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Optional: email the team on every new lead via Resend.
RESEND_API_KEY=
LEADS_INBOX=
LEADS_FROM=
